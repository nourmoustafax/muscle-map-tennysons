    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "papaparse": "5.5.3",
    "three": "0.180.0"
  }
}
